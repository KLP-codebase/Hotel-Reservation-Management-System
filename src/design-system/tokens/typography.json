{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "sn": {
    "font": {
      "family": {
        "display": {
          "$value": "'Cardinal Classic Long', serif",
          "$type": "fontFamily",
          "$description": "Serif display face — headings, pull quotes, editorial titles only."
        },
        "body": {
          "$value": "'Inter Tight', sans-serif",
          "$type": "fontFamily",
          "$description": "Sans-serif body face — body text, UI labels, captions, meta."
        }
      },
      "size": {
        "h1": {
          "$value": "clamp(2.5rem, 6vw, 5rem)",
          "$type": "dimension",
          "$description": "Display / H1. Cardinal Classic Long."
        },
        "h2": {
          "$value": "clamp(2rem, 4vw, 3.5rem)",
          "$type": "dimension",
          "$description": "H2. Cardinal Classic Long."
        },
        "h3": {
          "$value": "clamp(1.5rem, 2.5vw, 2rem)",
          "$type": "dimension",
          "$description": "H3. Cardinal Classic Long."
        },
        "body": {
          "$value": "1.0625rem",
          "$type": "dimension",
          "$description": "Body text. 17px. Inter Tight."
        },
        "caption": {
          "$value": "1rem",
          "$type": "dimension",
          "$description": "Caption / meta. 16px. Inter Tight."
        },
        "label": {
          "$value": "0.875rem",
          "$type": "dimension",
          "$description": "Button / nav label. 14px. Inter Tight weight 500."
        }
      },
      "weight": {
        "regular": { "$value": "400", "$type": "fontWeight" },
        "medium":  { "$value": "500", "$type": "fontWeight" }
      },
      "lineHeight": {
        "display": { "$value": "1.05", "$type": "number", "$description": "H1" },
        "heading":  { "$value": "1.1",  "$type": "number", "$description": "H2" },
        "subhead":  { "$value": "1.2",  "$type": "number", "$description": "H3 / italic title" },
        "body":     { "$value": "1.5",  "$type": "number" },
        "caption":  { "$value": "1.4",  "$type": "number" },
        "label":    { "$value": "1",    "$type": "number" }
      }
    }
  },
  "_note": "IMPORTANT — known extraction issue: tokens/typography.json originally listed font filenames (CardinalClassicMidWeb-*) that are not bundled. Use src/design-system/assets/fonts.css which maps to the actual local() sources. Cardinal Classic Long is a commercial typeface; license before production."
}
