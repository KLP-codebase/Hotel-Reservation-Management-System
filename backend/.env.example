# ── Backend Environment Variables ─────────────────────────────────────────────
# Copy to .env and fill in values before running.

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/skynest

# JWT
JWT_SECRET=change-me-to-a-long-random-string-before-any-shared-env
JWT_EXPIRES_IN=8h

# Server
PORT=4000
NODE_ENV=development

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000

# ── Email Delivery Strategy (console | smtp | resend) ──────────────────────────
# 'console' is ideal for local development (prints verification/invite links in terminal)
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@skynest.lk
APP_URL=http://localhost:3000

# Resend Provider (required when EMAIL_PROVIDER=resend)
# RESEND_API_KEY=re_your_api_key_here

# SMTP Provider (required when EMAIL_PROVIDER=smtp)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
