# ── Backend Environment Variables ─────────────────────────────────────────────
# Copy to .env and fill in values before running.

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/skynest

# JWT
JWT_SECRET=change-me-to-a-long-random-string-before-any-shared-env
JWT_EXPIRES_IN=8h

# Server
PORT=4000
NODE_ENV=development

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000

# ── Email Delivery Strategy (console | smtp | resend) ──────────────────────────
# 'console' is ideal for local development (prints verification/invite links in terminal)
# Production uses 'resend' (set in infrastructure/azure/docker-compose.prod.yml).
# Your local .env is never updated by git: change EMAIL_PROVIDER here to test real email.
EMAIL_PROVIDER=console
# EMAIL_FROM must use the domain verified in Resend (mail.skynest.me). Resend rejects
# other senders such as gmail.com or skynest.lk.
EMAIL_FROM="Sky Nest <noreply@mail.skynest.me>"
APP_URL=http://localhost:3000

# Gemini AI (virtual concierge chatbot). Optional: without it the chatbot reports
# that the key is not configured. Production: set in /opt/skynest/.env on the VM.
# GEMINI_API_KEY=your_gemini_api_key_here

# Contact form: inbox that receives messages (defaults to the value in src/config/env.ts)
# CONTACT_INBOX_EMAIL=team-inbox@example.com

# Resend Provider (required when EMAIL_PROVIDER=resend)
# The key must come from the Resend account/team that owns mail.skynest.me.
# A key from any other account can only send to that account's own email address.
# Ask the team owner for a key (Sending access, restricted to mail.skynest.me).
# Never commit a real key.
# RESEND_API_KEY=re_your_api_key_here

# SMTP Provider (required when EMAIL_PROVIDER=smtp)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
