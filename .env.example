# ============================================================
# Sky Nest HRGSMS — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values:
#   Windows: copy .env.example .env
#   Mac/Linux: cp .env.example .env
#
# .env is in .gitignore — never commit it to Git.
# This .env.example file IS committed — it's the template.
# ============================================================

# ── Database ────────────────────────────────────────────────
# Use 'localhost' when running backend with: npm run dev
# Use 'postgres'  when running backend inside Docker container
DATABASE_URL=postgresql://postgres:skynest_dev@localhost:5432/skynest

# ── Authentication ──────────────────────────────────────────
# Secret key used to sign JWT tokens. Keep this private in production.
# For local dev, this value is shared with the team.
JWT_SECRET=skynest-local-dev-secret

# ── App ─────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
ALLOWED_ORIGINS=http://localhost:3000
