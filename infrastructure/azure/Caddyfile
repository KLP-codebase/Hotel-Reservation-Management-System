{$APP_DOMAIN} {
	encode zstd gzip

	# Express owns /api/v1/* and /health. Everything else is Next.js.
	@backend path /api/v1/* /health
	handle @backend {
		reverse_proxy backend:4000
	}

	# Static images: replace Next.js's "max-age=0" with a 7-day cache.
	# header_down overwrites the upstream value (a plain `header` would add a second one).
	@images path *.jpg *.jpeg *.png *.webp *.avif
	handle @images {
		reverse_proxy frontend:3000 {
			header_down Cache-Control "public, max-age=604800"
		}
	}

	handle {
		reverse_proxy frontend:3000
	}
}

# Old and alternate hostnames redirect to the primary domain.
www.{$APP_DOMAIN}, skynest.dpdns.org, skynest-hotels.indiasouthcentral.cloudapp.azure.com {
	redir https://{$APP_DOMAIN}{uri} permanent
}
