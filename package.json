    "@types/jsonwebtoken": "^9.0.6",
    "@types/uuid": "^10.0.0",
    "typescript": "^5",
    "tailwindcss": "^3.4.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.39",
    "tailwindcss-animate": "^1.0.7",
    "eslint": "^8",
    "eslint-config-next": "14.2.25",
