    "jsonwebtoken": "^9.0.2",
    "zod": "^3.23.8",
    "@tanstack/react-query": "^5.51.1",
    "axios": "^1.7.3",
    "date-fns": "^3.6.0",
    "react-hook-form": "^7.52.2",
    "@hookform/resolvers": "^3.9.0",
    "recharts": "^2.12.7",
    "lucide-react": "^0.408.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.4.0",
    "next-auth": "5.0.0-beta.19",
    "@radix-ui/react-dialog": "^1.1.1",
