# ── Database ────────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/hotel_rms?schema=public"

# ── Server ──────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
API_VERSION=v1
CORS_ORIGIN=http://localhost:3000

# ── JWT ─────────────────────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-token-secret
JWT_REFRESH_EXPIRES_IN=30d

# ── PayHere ─────────────────────────────────────────────────────────────────────
PAYHERE_MERCHANT_ID=your-merchant-id
PAYHERE_MERCHANT_SECRET=your-merchant-secret
PAYHERE_WEBHOOK_SECRET=your-webhook-secret
PAYHERE_MODE=sandbox

# ── OTA Integration ─────────────────────────────────────────────────────────────
BOOKING_COM_API_KEY=your-booking-com-api-key
BOOKING_COM_HOTEL_ID=your-hotel-id
AGODA_API_KEY=your-agoda-api-key
AGODA_HOTEL_ID=your-hotel-id

# ── Cloudflare ──────────────────────────────────────────────────────────────────
CF_TURNSTILE_SECRET_KEY=your-turnstile-secret
CF_WORKERS_TOKEN=your-workers-api-token
